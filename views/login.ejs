<%# Login-/Register-Seite mit EJS-Layout %>
<%- include('partials/header', {
   title: typeof title !== 'undefined' ? title : 'Anmeldung | DogTrainer Hub',
   bodyClass: typeof bodyClass !== 'undefined' ? bodyClass : 'login-page',
   extraCss: typeof extraCss !== 'undefined' ? extraCss : []
}) %>
<%- include('partials/navigation', {
   showNavLinks: false,
   showLogoutButton: false
}) %>

<main class="login-layout">
   <!-- Linke Intro-Spalte -->
   <section class="login-intro" aria-labelledby="login-heading">
      <div>
         <h1 id="login-heading">Training beginnt<br /><span>mit Vertrauen.</span></h1>
         <p>Organisiere Hunde, Übungen und Training an einem Ort.</p>
         <div class="login-paws" aria-hidden="true">🐾🐾</div>
      </div>
   </section>

   <!-- Rechte Formular-Spalte -->
   <section class="login-area" aria-labelledby="form-heading">
      <div class="login-card">
         <h2 id="form-heading">Willkommen zurück</h2>
         <p class="login-subtitle">Melde dich in deinem Konto an.</p>

         <!-- Login-Form -->
         <form id="login-form">
            <label for="email">E-Mail-Adresse</label>
            <input id="email" name="email" type="email" placeholder="name@beispiel.at" autocomplete="username" required />

            <label for="password">Passwort</label>
            <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required />

            <div class="login-options">
               <label class="remember-login" for="remember">
                  <input id="remember" name="remember" type="checkbox" />
                  Angemeldet bleiben
               </label>
               <button class="login-text-button" type="button" data-login-help="Das Zurücksetzen des Passworts ist noch nicht verfügbar.">
                  Passwort vergessen?
               </button>
            </div>

            <button class="start-button login-submit" type="submit">Anmelden</button>
         </form>

         <p class="login-register">
            Noch kein Konto?
            <button id="toggle-register" class="login-text-button" type="button">Registrieren</button>
         </p>

         <!-- Register-Form -->
         <form id="register-form" hidden>
            <label for="register-email">E-Mail-Adresse</label>
            <input id="register-email" name="register-email" type="email" placeholder="name@beispiel.at" autocomplete="email" required />

            <label for="register-password">Passwort</label>
            <input id="register-password" name="register-password" type="password" placeholder="mindestens 6 Zeichen" autocomplete="new-password" required />

            <label for="register-password-repeat">Passwort wiederholen</label>
            <input id="register-password-repeat" name="register-password-repeat" type="password" placeholder="Passwort wiederholen" autocomplete="new-password" required />

            <button class="start-button login-submit" type="submit">Konto erstellen</button>
         </form>

         <p class="login-message" id="login-message" role="status"></p>
      </div>
   </section>
</main>

<script type="module" src="/js/auth/login-page.js"></script>
</body>
</html>



