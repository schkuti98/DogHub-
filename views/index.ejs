<%# Startseite mit wiederverwendeten Layout-Bausteinen %>
<%- include('partials/header', {
   title: typeof title !== 'undefined' ? title : 'DogTrainer Hub',
   bodyClass: typeof bodyClass !== 'undefined' ? bodyClass : '',
   extraCss: typeof extraCss !== 'undefined' ? extraCss : []
}) %>
<%- include('partials/navigation', {
   currentPage: typeof currentPage !== 'undefined' ? currentPage : 'home',
   showLogoutButton: true
}) %>

<main>
   <!-- Hero-Bereich -->
   <section class="welcome">
      <h1>Willkommen beim DogTrainer Hub</h1>
      <p>Deine Hunde und ihre Tricks im Überblick.</p>
      <a class="start-button" href="/app/tricks">Training starten</a>
   </section>

   <!-- Schnellübersicht Hunde -->
   <section class="dogs">
      <h2>Meine Hunde</h2>
      <div id="home-dog-list" class="dog-list">
         <p>Hunde werden geladen...</p>
      </div>
      <a class="add-dog" href="/app/dogs">+ Hund hinzufügen</a>
   </section>

   <!-- Schnellzugriff auf Tricks -->
   <section class="tricks">
      <h2>Alle Tricks</h2>
      <div class="trick-list">
         <a class="trick-card" href="/app/trick#sitz">
            <h3>Sitz</h3>
            <p>Grundgehorsam · Leicht</p>
         </a>
         <a class="trick-card" href="/app/trick#rolle">
            <h3>Rolle</h3>
            <p>Tricks · Mittel</p>
         </a>
         <a class="trick-card" href="/app/trick#criss-cross">
            <h3>Criss Cross</h3>
            <p>Tricks · Schwer</p>
         </a>
      </div>
   </section>
</main>

<%- include('partials/footer') %>
<script type="module" src="/js/auth/guard.js"></script>
<script type="module" src="/js/tricks/tricks-page.js"></script>
<script type="module" src="/js/dogs/home-dogs.js"></script>
</body>
</html>


