<%# Hunde-Verwaltungsseite im bestehenden Design %>
<%- include('partials/header', {
   title: typeof title !== 'undefined' ? title : 'Meine Hunde | DogTrainer Hub',
   bodyClass: typeof bodyClass !== 'undefined' ? bodyClass : '',
   extraCss: typeof extraCss !== 'undefined' ? extraCss : ['https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css']
}) %>
<%- include('partials/navigation', {
   currentPage: typeof currentPage !== 'undefined' ? currentPage : 'dogs',
   showLogoutButton: true
}) %>

<main class="dogs-page">
   <!-- Formular zum Hund anlegen -->
   <section class="welcome">
      <h1>Meine Hunde</h1>
      <p>Hier siehst du deine Hunde und ihren Fortschritt.</p>

      <form id="dog-form" class="profile-columns" aria-label="Hund hinzufügen">
         <div>
            <label for="dog-name" class="form-label">Name</label>
            <input id="dog-name" name="name" type="text" class="form-control" placeholder="z. B. Bella" required />

            <label for="dog-breed" class="form-label mt-2">Rasse</label>
            <input id="dog-breed" name="breed" type="text" class="form-control" placeholder="z. B. Labrador" required />

            <label for="dog-age" class="form-label mt-2">Alter</label>
            <input id="dog-age" name="age" type="number" class="form-control" min="0" step="1" placeholder="z. B. 3" />

            <button class="btn btn-warning mt-3" type="submit">Hund hinzufügen</button>
         </div>
      </form>
   </section>

   <!-- Liste für bestehende Hunde -->
   <section class="dog-profile" aria-labelledby="dog-list-title">
      <div class="profile-header">
         <div>
            <h2 id="dog-list-title">Hundeliste</h2>
            <p>Alle Hunde aus der Datenbank. Du kannst sie hier löschen.</p>
         </div>
      </div>

      <p id="dog-message" class="login-message" role="status"></p>
      <div id="dog-list" class="dog-list" aria-live="polite"></div>
   </section>
</main>

<%- include('partials/footer') %>
<script type="module" src="/js/auth/guard.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="module" src="/js/dogs/dogs-page.js"></script>
</body>
</html>


